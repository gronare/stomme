---
import { getEntry, getCollection } from 'astro:content';
// @ts-expect-error — virtual alias, no static types.
import { site, features, listings } from '@stomme/config';
import { resolveShareImage, shareImageSize, type ImageSize } from './src/og-pages.ts';
import { canonicalBounceHost, demoHost, isUnlisted } from './src/config.ts';
import { localBusinessJsonLd } from './src/local-business.ts';
import { organizationJsonLd, softwareJsonLd, websiteJsonLd } from './src/site-schema.ts';
import { hreflangLinks, normalizeLocalePath, resolveLocales, splitLocalePath } from './src/i18n.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  manifest?: string;
  themeColor?: string;
}
const { title, description, image, manifest, themeColor } = Astro.props;

const settings = (await getEntry('settings', 'site'))!.data;

const favicon = settings.favicon || '/favicon.svg';
const faviconType = favicon.endsWith('.svg') ? 'image/svg+xml'
  : favicon.endsWith('.png') ? 'image/png'
  : favicon.endsWith('.ico') ? 'image/x-icon' : undefined;

// resolveShareImage must enumerate pages exactly as the OG endpoint's getStaticPaths does, or a card URL is emitted for a card that was never built.
const ogTitle = title ?? settings.name;
const shareImage = await resolveShareImage(Astro.url.pathname, image, { features, routes: site.routes, listings });
const uploadedAssetUrls = import.meta.glob('/src/assets/media/**/*', { query: '?url', import: 'default', eager: true }) as Record<string, string>;
const shareKey = shareImage && shareImage.startsWith('/media/') ? `/src/assets/media/${shareImage.slice('/media/'.length)}` : null;
const servedShareImage = shareKey ? (uploadedAssetUrls[shareKey] ?? shareImage) : shareImage;
const ogImage = servedShareImage
  ? (Astro.site ? new URL(servedShareImage, Astro.site).href : servedShareImage)
  : undefined;
const uploadedImageSizes = import.meta.glob('/src/assets/media/**/*.{png,jpg,jpeg,webp,gif,avif}', { import: 'default', eager: true }) as Record<string, ImageSize>;
const ogImageSize = ogImage ? shareImageSize(shareImage, uploadedImageSizes) : null;
const ogUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const pageLocals = (Astro.locals ?? {}) as { stommeMarkdown?: string; stommeRobots?: string };

const locales = resolveLocales(site);
// The noindex list is written in site paths, so a locale copy of an unlisted page has to be measured against the same path or it would be the one that gets indexed.
const listPath = splitLocalePath(Astro.url.pathname, locales).path;
const noindex = isUnlisted(listPath, site?.noindex, site?.routes?.formSuccess) || (Astro.site ? demoHost(new URL(Astro.site).hostname) : false);
const robots = noindex ? 'noindex, nofollow' : pageLocals.stommeRobots;
const alternates = hreflangLinks(Astro.url.pathname, site, Astro.site, locales.enabled ? await getCollection('pages') : []);
const bounceHost = canonicalBounceHost(Astro.site);
const schemeAuto = ((await getEntry('theme', 'theme').catch(() => null))?.data as { scheme?: string } | undefined)?.scheme === 'auto';

// Set by a route before this layout renders: the docs publish each page as Markdown and keep an unreleased version out of the index.
const markdownAlternate = pageLocals.stommeMarkdown;
const isHome = normalizeLocalePath(Astro.url.pathname) === '/';
const contact = isHome ? ((await getEntry('contact', 'contact')?.catch(() => null))?.data as any) ?? {} : {};
const towns = isHome && features?.areas ? await getCollection('towns').catch(() => []) : [];
const siteOrigin = Astro.site ? new URL(Astro.site).origin : undefined;
const absolute = (path?: string) => (path && Astro.site ? new URL(path, Astro.site).href : path);
const localBusiness = isHome
  ? localBusinessJsonLd({
      name: settings.name,
      url: siteOrigin,
      image: absolute(settings.ogImage),
      contact,
      towns: towns.map((t: any) => t.data?.name),
    })
  : null;
const schemaInput = { name: settings.name, url: siteOrigin, logo: absolute(settings.logo?.image), sameAs: (contact.socials ?? []).map((s: any) => s?.url), software: site?.software };
// LocalBusiness is already an Organization, and a second node for the same business would read as two.
const homeSchemas = isHome ? [localBusiness ?? organizationJsonLd(schemaInput), websiteJsonLd(schemaInput), softwareJsonLd(schemaInput)].filter(Boolean) : [];
---
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="format-detection" content="telephone=no" />
{schemeAuto && <script is:inline>try{var t=localStorage.getItem('stomme-theme');if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>}
{bounceHost && <script is:inline define:vars={{ bounceHost }}>
  var host = location.hostname;
  if (host !== bounceHost && (host.endsWith('.pages.dev') || host.endsWith('.workers.dev'))) location.replace('https://' + bounceHost + location.pathname + location.search + location.hash);
</script>}
<title>{title ?? settings.name}</title>
{description && <meta name="description" content={description} />}
{robots && <meta name="robots" content={robots} />}
{ogUrl && <link rel="canonical" href={ogUrl} />}
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{markdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}
<meta property="og:title" content={ogTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={settings.name} />
{ogUrl && <meta property="og:url" content={ogUrl} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)} />}
{ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{homeSchemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}
<link rel="icon" href={favicon} type={faviconType} />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
{settings.appleIcon && <link rel="apple-touch-icon" href={settings.appleIcon} />}
{manifest && <link rel="manifest" href={manifest} />}
{themeColor && <meta name="theme-color" content={themeColor} />}
