{
  "name": "@gronare/stomme",
  "version": "0.1.79",
  "description": "Block-CMS engine for Astro + Sveltia CMS — types, helpers, runtime components, tooling.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gronare/stomme.git"
  },
  "exports": {
    "./kit": "./src/kit.ts",
    "./href": "./src/href.ts",
    "./markdown": "./src/markdown.ts",
    "./fonts": "./src/fonts.ts",
    "./config": "./src/config.ts",
    "./calendar": "./src/calendar.ts",
    "./i18n": "./src/i18n.ts",
    "./contact": "./src/contact.ts",
    "./catalog": "./catalog.ts",
    "./collections": "./collections.ts",
    "./addon-collections": "./addon-collections.ts",
    "./integration": {
      "types": "./integration.d.ts",
      "default": "./integration.mjs"
    },
    "./styles.css": "./styles.css",
    "./Cover.astro": "./src/Cover.astro",
    "./Icon.astro": "./src/Icon.astro",
    "./BlockRenderer.astro": "./src/BlockRenderer.astro",
    "./Header.astro": "./chrome/Header.astro",
    "./Footer.astro": "./chrome/Footer.astro",
    "./Head.astro": "./Head.astro",
    "./Thanks.astro": "./Thanks.astro",
    "./Tracking.astro": "./chrome/Tracking.astro",
    "./Metrics.astro": "./chrome/Metrics.astro",
    "./ConsentBanner.astro": "./chrome/ConsentBanner.astro",
    "./DirectContact.astro": "./src/DirectContact.astro",
    "./ContactLink.astro": "./src/ContactLink.astro",
    "./TownPage.astro": "./TownPage.astro",
    "./ServicePage.astro": "./ServicePage.astro",
    "./PostPage.astro": "./PostPage.astro",
    "./CatalogPage.astro": "./CatalogPage.astro",
    "./routes/*": "./routes/*",
    "./blocks/*": "./blocks/*",
    "./virtual-aliases": "./virtual-aliases.d.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:schema-manifest": "node bin/gen-schema-manifest.mjs",
    "gen:blocks-manifest": "node bin/gen-blocks-manifest.mjs",
    "test:preview-workerd": "node test/smoke-preview-workerd.mjs",
    "test:og": "node test/smoke-og.mjs",
    "test:addon-routes": "node test/smoke-addon-routes.mjs",
    "test:addon-cms": "node test/smoke-addon-cms.mjs",
    "test:admin-contract": "node test/admin-contract.mjs",
    "test:noindex": "node test/smoke-noindex.mjs",
    "test:addon-blocks": "node test/smoke-addon-blocks.mjs",
    "test:addon-lookbook": "node test/smoke-addon-lookbook.mjs",
    "test:public-index": "node test/smoke-public-index.mjs",
    "test:slots": "node test/smoke-slots.mjs",
    "test:metrics": "node test/smoke-metrics.mjs",
    "test:maps": "node test/smoke-maps.mjs",
    "test:turnstile": "node test/smoke-turnstile.mjs",
    "test:locale-urls": "node test/smoke-locale-urls.mjs",
    "test:map-proxy": "node test/smoke-map-proxy.mjs",
    "lint:comments": "node bin/lint-comments.mjs .",
    "test:contracts": "node test/cross-file-contracts.mjs",
    "test:emit-fields": "node test/unit-emit-fields.mjs",
    "test:collection-editors": "node test/unit-collection-editors.mjs",
    "test:option-sources": "node test/unit-option-sources.mjs",
    "test:admin-theme": "node test/unit-admin-theme.mjs",
    "test:markdown": "node test/unit-markdown.mjs",
    "test:href": "node test/unit-href.mjs",
    "test:config": "node test/unit-config.mjs",
    "test:i18n": "node test/unit-i18n.mjs",
    "test:kit": "node test/unit-kit.mjs",
    "test:icons": "node test/unit-icons.mjs",
    "test:protect": "node test/unit-protect.mjs",
    "test:og-pages": "node test/unit-og-pages.mjs",
    "test:media-config": "node test/unit-media-config.mjs",
    "test:anchors": "node test/unit-anchors.mjs",
    "test:units": "pnpm -s run test:contracts && pnpm -s run test:emit-fields && pnpm -s run test:collection-editors && pnpm -s run test:option-sources && pnpm -s run test:admin-theme && pnpm -s run test:markdown && pnpm -s run test:href && pnpm -s run test:config && pnpm -s run test:i18n && pnpm -s run test:kit && pnpm -s run test:icons && pnpm -s run test:protect && pnpm -s run test:og-pages && pnpm -s run test:media-config && pnpm -s run test:anchors && pnpm -s run test:nav-current",
    "test:nav-current": "node test/unit-nav-current.mjs"
  },
  "bin": {
    "stomme-gen": "bin/gen-admin-blocks.mjs",
    "stomme-gen-schema": "bin/gen-schema-manifest.mjs",
    "stomme-gen-blocks": "bin/gen-blocks-manifest.mjs",
    "stomme-new-block": "bin/new-block.mjs",
    "stomme-lint-styles": "bin/lint-styles.mjs",
    "stomme-lint-comments": "bin/lint-comments.mjs"
  },
  "files": [
    "src",
    "bin",
    "admin",
    "assets",
    "blocks",
    "chrome",
    "routes",
    "catalog.ts",
    "collections.ts",
    "addon-collections.ts",
    "schema-manifest.json",
    "blocks-manifest.json",
    "integration.mjs",
    "integration.d.ts",
    "Head.astro",
    "Thanks.astro",
    "TownPage.astro",
    "ServicePage.astro",
    "PostPage.astro",
    "CatalogPage.astro",
    "styles.css",
    "virtual-aliases.d.ts"
  ],
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/inter-tight": "^5.2.7",
    "@resvg/resvg-js": "^2.6.2",
    "jiti": "^2.6.0",
    "marked": "^18.0.5",
    "satori": "^0.26.0",
    "sharp": "^0.35.3"
  },
  "peerDependencies": {
    "astro": ">=5"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1"
  },
  "license": "AGPL-3.0-only"
}
