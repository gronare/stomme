---
import { getEntry, getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveLink } from '../src/href';
import { resolveLocales, splitLocalePath, localeEntryId, localeLinker } from '../src/i18n';
import { site } from '@stomme/config';
import { resolveSite } from '../src/config';
import ContactLink from '../src/ContactLink.astro';
// Rendered flush after .inner's close tag — on its own line the newline would collapse to a space on every page of every site.
import SlotFooterEnd from '@stomme/slot-footer-end';
import Metrics from './Metrics.astro';

interface FooterData { dark?: boolean; tagline?: string; showAddress?: boolean; showHours?: boolean; showSocials?: boolean; showLinks?: boolean; linksHeading?: string; links?: { label: string; link?: unknown }[]; links2Heading?: string; links2?: { label: string; link?: unknown }[]; showTowns?: boolean; townsHeading?: string; legal?: { label: string; link?: unknown }[]; note?: string; showLogo?: boolean; showWordmark?: boolean }
interface SettingsData { name?: string; logo?: { textPre?: string; textAccent?: string; image?: string; alt?: string } }
interface ContactData { email?: string; phone?: string; phoneE164?: string; protectContact?: boolean; address?: { street?: string; postcode?: string; city?: string }; hours?: { days?: string; hours?: string }[]; hoursNote?: string; socials?: { platform?: string; url?: string }[]; orgNr?: string; founded?: string }
interface Props { footer?: FooterData; settings?: SettingsData; contact?: ContactData; towns?: { id: string; name: string }[]; townsHref?: string }

let { footer, settings, contact, towns, townsHref } = Astro.props;
const locales = resolveLocales(site);
const here = splitLocalePath(Astro.url.pathname, locales);
const footerId = localeEntryId('footer', here.locale, locales.default);
if (!footer) footer = ((footerId !== 'footer' && (await getEntry('footer', footerId))) || (await getEntry('footer', 'footer'))!).data as FooterData;
if (!settings) settings = (await getEntry('settings', 'site'))!.data as SettingsData;
if (!contact) contact = (((await getEntry('contact', 'contact').catch(() => null))?.data) ?? {}) as ContactData;

const fstrings = resolveSite(site, here.locale).strings.footer;
const inLocale = localeLinker(site, here.locale, locales.enabled ? await getCollection('pages') : []);
const logo = settings.logo ?? {};
const showMark = footer.showLogo === true && !!logo.image;
const showWord = footer.showWordmark === true && !!logo.textPre;
const logoUploads = import.meta.glob<{ default: ImageMetadata }>('/src/assets/media/**/*.{jpg,jpeg,png,webp,avif}');
const logoKey = logo.image && logo.image.startsWith('/media/') ? `/src/assets/media/${logo.image.slice('/media/'.length)}` : null;
const logoOptimized = logoKey && logoUploads[logoKey] ? logoUploads[logoKey] : null;
const links = footer.links ?? [];
const links2 = footer.links2 ?? [];
const legal = footer.legal ?? [];
const showAddress = footer.showAddress === true;
const tagline = showAddress ? footer.tagline : [footer.tagline, contact.address?.city].filter(Boolean).join(' · ');
const address = [contact.address?.street, [contact.address?.postcode, contact.address?.city].filter(Boolean).join(' ')].filter(Boolean).join(', ');
const hours = footer.showHours === true
  ? [...(contact.hours ?? []).map((h) => [h.days, h.hours].filter(Boolean).join(' ')), contact.hoursNote].filter(Boolean).join(' · ')
  : '';
const socials = footer.showSocials === true ? (contact.socials ?? []).filter((s) => s && s.url) : [];
const orgLine = [contact.orgNr && `Org.nr ${contact.orgNr}`, contact.founded && `Est. ${contact.founded}`].filter(Boolean).join(' · ');
const year = new Date().getFullYear();
---
<footer class:list={['site-footer', { 'site-footer--dark': footer.dark }]}>
  <div class="inner">
    <div class="footer-grid">
      <div>
        <div class="logo" style="margin:0">
          {showMark && (logoOptimized
            ? <Image class="logo-mark" src={logoOptimized()} alt={logo.alt ?? ''} />
            : <img class="logo-mark" src={logo.image} alt={logo.alt ?? ''} />)}
          {showWord && <span class="logo-word">{logo.textPre}<span class="accent">{logo.textAccent}</span></span>}
        </div>
        {tagline && <p style="margin:0.5rem 0 0;max-width:36rem">{tagline}</p>}
        {showAddress && address && <p class="footer-address">{address}</p>}
        {hours && <p class="footer-hours">{hours}</p>}
        {socials.length > 0 && (
          <ul class="footer-socials">
            {socials.map((s) => <li><a href={s.url} class="footer-link" target="_blank" rel="noopener">{s.platform}</a></li>)}
          </ul>
        )}
        {footer.showContact !== false && (contact.phone || contact.email) && (
          <p style="margin:0.75rem 0 0">
            {contact.phone && <ContactLink kind="tel" class="footer-link" target={contact.phoneE164 || contact.phone} display={contact.phone} protect={!!contact.protectContact} />}
            {contact.phone && contact.email && <span> · </span>}
            {contact.email && <ContactLink kind="mailto" class="footer-link" target={contact.email} display={contact.email} protect={!!contact.protectContact} />}
          </p>
        )}
        {orgLine && <p class="mono" style="margin-top:1rem">{orgLine}</p>}
      </div>
      {((footer.showLinks === true && links.length > 0) || links2.length > 0 || (footer.showTowns && towns && towns.length > 0)) && (
        <div class="footer-cols">
          {footer.showLinks === true && links.length > 0 && (
            <nav>
              <p class="mono eyebrow">{footer.linksHeading || fstrings.links}</p>
              <ul class="footer-links">
                {links.map((l) => <li><a href={inLocale(resolveLink(l.link, '/'))} class="footer-link">{l.label}</a></li>)}
              </ul>
            </nav>
          )}
          {links2.length > 0 && (
            <nav>
              <p class="mono eyebrow">{footer.links2Heading ?? ''}</p>
              <ul class="footer-links">
                {links2.map((l) => <li><a href={inLocale(resolveLink(l.link, '/'))} class="footer-link">{l.label}</a></li>)}
              </ul>
            </nav>
          )}
          {footer.showTowns && towns && towns.length > 0 && (
            <nav>
              <p class="mono eyebrow">{footer.townsHeading || fstrings.areas}</p>
              <ul class="footer-links footer-towns">
                {towns.map((t) => <li><a href={`${townsHref ?? '/areas'}/${t.id}`} class="footer-link">{t.name}</a></li>)}
              </ul>
            </nav>
          )}
        </div>
      )}
    </div>
    <div class="footer-bar">
      <p class="mono" style="margin:0">© {contact.founded ? `${contact.founded}–` : ''}{year} {settings.name}{footer.note ? ` · ${footer.note}` : ''}</p>
      {legal.length > 0 && (
        <ul class="footer-legal">
          {legal.map((l) => <li><a href={inLocale(resolveLink(l.link, '/'))} class="footer-link">{l.label}</a></li>)}
        </ul>
      )}
    </div>
  </div><SlotFooterEnd /><Metrics />
</footer>
