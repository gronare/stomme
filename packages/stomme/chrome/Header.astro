---
import { getEntry, getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveLink } from '../src/href';
import { resolveLocales, splitLocalePath, localeEntryId, localeLinker, localeSwitcher, defaultLocaleEntries } from '../src/i18n';
import { pageChildren, pagePaths, pageTitle } from '../src/pages';
import { normalizeNavPath, currentNavPath } from '../src/nav-current';
import { resolveSite } from '../src/config';
import LangSwitcher from './LangSwitcher.astro';
// @ts-expect-error — virtual alias, no static types.
import { site } from '@stomme/config';
import SlotHeaderStart from '@stomme/slot-header-start';
import SlotHeaderNavEnd from '@stomme/slot-header-nav-end';
import SlotHeaderEnd from '@stomme/slot-header-end';

interface NavLink { label: string; link?: unknown }
interface NavItem extends NavLink { menu?: string; autoChildren?: boolean; children?: NavLink[] }
interface NavData {
  items?: NavItem[];
  cta?: { label: string; link?: unknown };
  sticky?: boolean | 'true' | 'false' | 'phone';
  showLogo?: boolean;
  showWordmark?: boolean;
}
interface SiteData { name?: string; languageSwitcher?: 'globe' | 'flags'; logo?: { textPre?: string; textAccent?: string; image?: string; imageDark?: string; plate?: boolean; alt?: string } }
interface Props { nav?: NavData; settings?: SiteData }

let { nav, settings } = Astro.props;
const locales = resolveLocales(site);
const here = splitLocalePath(Astro.url.pathname, locales);
const navId = localeEntryId('nav', here.locale, locales.default);
if (!nav) nav = ((navId !== 'nav' && (await getEntry('navigation', navId))) || (await getEntry('navigation', 'nav'))!).data as NavData;
if (!settings) settings = (await getEntry('settings', 'site'))!.data as SiteData;
const items = nav.items ?? [];
const autoNav = items.some((i) => i.autoChildren === true);
const pageEntries = locales.enabled || autoNav ? await getCollection('pages') : [];
const langs = locales.enabled
  ? localeSwitcher(Astro.url.pathname, site, [...pageEntries, ...(await getCollection('home'))])
  : [];
const langLabel = resolveSite(site, here.locale).strings.changeLanguage;

const logo = settings.logo ?? {};
const showMark = nav.showLogo === true && !!logo.image;
const showWord = nav.showWordmark === true && !!logo.textPre;
const logoUploads = import.meta.glob<{ default: ImageMetadata }>('/src/assets/media/**/*.{jpg,jpeg,png,webp,avif}');
const logoKey = logo.image && logo.image.startsWith('/media/') ? `/src/assets/media/${logo.image.slice('/media/'.length)}` : null;
const logoOptimized = logoKey && logoUploads[logoKey] ? logoUploads[logoKey] : null;
const logoDarkKey = logo.imageDark && logo.imageDark.startsWith('/media/') ? `/src/assets/media/${logo.imageDark.slice('/media/'.length)}` : null;
const logoDarkOptimized = logoDarkKey && logoUploads[logoDarkKey] ? logoUploads[logoDarkKey] : null;
const inLocale = localeLinker(site, here.locale, locales.enabled ? pageEntries : []);
const homeHref = inLocale('/');
const ownPages = autoNav ? defaultLocaleEntries(pageEntries, site) : [];
const ownPagePaths = autoNav ? pagePaths(ownPages) : new Map<string, string>();

async function childrenOf(item: NavItem): Promise<{ label: string; href: string }[]> {
  if (item.menu) {
    const [id, base] = String(item.menu).split('::');
    try {
      const entries = await getCollection(id as any);
      entries.sort((a: any, b: any) => {
        const da = a.data.date, db = b.data.date;
        if (da && db) return da < db ? 1 : -1;
        return String(a.data.navLabel ?? a.data.title ?? a.id).localeCompare(String(b.data.navLabel ?? b.data.title ?? b.id));
      });
      return entries.map((e: any) => ({ label: e.data.navLabel ?? e.data.title ?? e.id, href: `${base}/${e.id}` }));
    } catch { return []; }
  }
  if (Array.isArray(item.children) && item.children.length) return item.children.map((c) => ({ label: c.label, href: resolveLink(c.link, homeHref) }));
  if (item.autoChildren === true) {
    const under = normalizeNavPath(resolveLink(item.link, ''));
    if (under === '/') return [];
    return pageChildren(under, ownPages).map((c) => ({ label: pageTitle(c), href: ownPagePaths.get(c.id) as string }));
  }
  return [];
}
const resolved = await Promise.all(
  items.map(async (i) => ({
    label: i.label,
    href: inLocale(resolveLink(i.link, '')),
    children: (await childrenOf(i)).map((c) => ({ ...c, href: inLocale(c.href) })),
  })),
);
// The CMS select writes its values as strings, older content carries the plain boolean, and both mean the same three states.
const sticky = nav.sticky === 'phone' ? 'phone' : nav.sticky === true || nav.sticky === 'true';
const navPath = (href: string) => normalizeNavPath(splitLocalePath(href, locales).path);
const current = currentNavPath(here.path, [homeHref, ...resolved.flatMap((i) => [i.href, ...i.children.map((c) => c.href)])].filter(Boolean).map(navPath));
const isActive = (href: string) => !!href && navPath(href) === current;
---
<header class:list={['site-header', { 'is-sticky': !!sticky, 'is-sticky--phone': sticky === 'phone' }]}>
  <div class="site-header__glass" aria-hidden="true"></div>
    <a class:list={['logo', { 'logo--plate': logo.plate === true }]} href={homeHref} aria-label={settings.name}>
      {showMark && (logoOptimized
        ? <Image class="logo-mark" src={logoOptimized()} alt={logo.alt ?? ''} />
        : <img class="logo-mark" src={logo.image} alt={logo.alt ?? ''} />)}
      {showMark && logo.imageDark && (logoDarkOptimized
        ? <Image class="logo-mark logo-mark--ondark" src={logoDarkOptimized()} alt={logo.alt ?? ''} />
        : <img class="logo-mark logo-mark--ondark" src={logo.imageDark} alt={logo.alt ?? ''} />)}
      {showWord && <span class="logo-word">{logo.textPre}<span class="accent">{logo.textAccent}</span></span>}
    </a>
    <SlotHeaderStart />
    <nav class="site-nav" id="site-nav">
      {resolved.map((i) => i.children.length ? (
        <div class="nav-item nav-item--menu">
          {i.href
            ? <a class:list={['nav-top', { 'is-active': isActive(i.href) || i.children.some((c) => isActive(c.href)) }]} href={i.href} aria-current={isActive(i.href) ? 'page' : undefined} aria-haspopup="true">{i.label}</a>
            : <span class:list={['nav-top', { 'is-active': i.children.some((c) => isActive(c.href)) }]} role="button" tabindex="0" aria-haspopup="true">{i.label}</span>}
          <button class="nav-caret-btn" type="button" aria-label="Show submenu" aria-expanded="false"><span class="nav-caret" aria-hidden="true"></span></button>
          <ul class="nav-submenu">
            {i.children.map((c) => <li><a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a></li>)}
          </ul>
        </div>
      ) : (
        <a href={i.href || homeHref} aria-current={isActive(i.href || homeHref) ? 'page' : undefined}>{i.label}</a>
      ))}
      {nav.cta && <a class="btn nav-cta" href={inLocale(resolveLink(nav.cta.link, homeHref))}>{nav.cta.label}</a>}
      {langs.length > 1 && (
        <span class="nav-langs">
          <LangSwitcher langs={langs} variant={settings.languageSwitcher} label={langLabel} />
        </span>
      )}
    </nav>
    <SlotHeaderNavEnd />
    {nav.cta && <a class="btn site-cta" href={inLocale(resolveLink(nav.cta.link, homeHref))}>{nav.cta.label}</a>}
    <SlotHeaderEnd />
    <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
    </button>
</header>
<div class="site-tint" aria-hidden="true"></div>
<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    if (!header) return;
    var toggle = header.querySelector('.nav-toggle');
    var mobile = window.matchMedia('(max-width: 820px)');

    // A click would pin a desktop dropdown open via :focus-within, so blur on click; on mobile the caret expands, and a link-less label expands instead of navigating.
    header.querySelectorAll('.nav-item--menu').forEach(function (item) {
      var top = item.querySelector('.nav-top');
      var caret = item.querySelector('.nav-caret-btn');
      var expand = function () {
        var open = !item.classList.contains('is-open');
        item.classList.toggle('is-open', open);
        if (caret) caret.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      if (caret) caret.addEventListener('click', function () { if (mobile.matches) expand(); caret.blur(); });
      if (top) top.addEventListener('click', function (e) {
        if (mobile.matches && top.tagName === 'SPAN') { e.preventDefault(); expand(); }
        else { top.blur(); }
      });
    });

    var langSwitch = header.querySelector('.lang-switch');
    if (langSwitch) {
      document.addEventListener('click', function (e) {
        if (langSwitch.open && !langSwitch.contains(e.target)) langSwitch.open = false;
      });
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape' || !langSwitch.open) return;
        langSwitch.open = false;
        var summary = langSwitch.querySelector('summary');
        if (summary) summary.focus();
      });
    }

    if (toggle) {
      var setOpen = function (open) {
        header.classList.toggle('nav-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      toggle.addEventListener('click', function () { setOpen(!header.classList.contains('nav-open')); });
      header.querySelectorAll('.site-nav a[href]:not(.nav-top), .site-cta').forEach(function (a) {
        a.addEventListener('click', function () { setOpen(false); });
      });
    }

    var inner = header;
    var cta = header.querySelector('.site-cta');
    var round = function (v) { return String(Math.round(v * 1000) / 1000); };
    var publishedZoom = '';
    var setZoom = function (z) {
      var value = round(z);
      if (value === publishedZoom) return;
      publishedZoom = value;
      header.style.setProperty('--header-zoom', value);
      document.documentElement.style.setProperty('--header-zoom', value);
    };
    // Measured at zoom 1, where every length is in plain px: the row scales linearly with --header-zoom, so the factor that fits is room over use; the open menu is absolute and full-width, so it is not a row child.
    var fit = function () {
      setZoom(1);
      var box = getComputedStyle(inner).display === 'contents' ? header : inner;
      var cs = getComputedStyle(box);
      var room = box.getBoundingClientRect().width - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      var gap = parseFloat(cs.columnGap) || 0, used = -gap;
      [].forEach.call(inner.children, function (el) {
        var k = getComputedStyle(el);
        if (k.display === 'none' || k.position === 'absolute' || k.position === 'fixed') return;
        used += el.getBoundingClientRect().width + (parseFloat(k.marginLeft) || 0) + (parseFloat(k.marginRight) || 0) + gap;
      });
      return Math.min(1, room / Math.max(used, 1));
    };
    var lastWidth = -1, fitting = false;
    // The row is drawn at its designed size while it fits the viewport and scaled down only by what it needs; the button keeps its place down to 85% of that size, then moves into the menu and the row takes the space.
    var fitRow = function (force) {
      if (!inner || fitting) return;
      var w = header.clientWidth;
      if (!force && w === lastWidth) return;
      fitting = true; lastWidth = w;
      header.classList.remove('cta-in-menu');
      var z = fit();
      if (cta && mobile.matches && z < 0.85) { header.classList.add('cta-in-menu'); z = fit(); }
      setZoom(z < 1 ? Math.max(0.3, z * 0.995) : 1);
      fitting = false;
    };
    var queued = false;
    var refit = function () {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () { queued = false; fitRow(true); });
    };
    fitRow(true);
    window.addEventListener('resize', function () { fitRow(false); }, { passive: true });
    // Slot content mounts into the row after first paint while the header's own box never changes, so what has to be watched is the row's children.
    if (window.ResizeObserver) {
      var rowSize = new ResizeObserver(refit);
      var watchRow = function () {
        rowSize.disconnect();
        rowSize.observe(header);
        [].forEach.call(inner.children, function (el) { rowSize.observe(el); });
      };
      watchRow();
      if (window.MutationObserver) new MutationObserver(function () { watchRow(); refit(); }).observe(inner, { childList: true, subtree: true });
    }
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { fitRow(true); });

    var publishedBottom = '';
    var publishBottom = function () {
      var bottom = (header.offsetTop + header.offsetHeight) + 'px';
      if (bottom === publishedBottom) return;
      publishedBottom = bottom;
      document.documentElement.style.setProperty('--header-bottom', bottom);
    };
    publishBottom();
    window.addEventListener('resize', publishBottom, { passive: true });
    if (window.ResizeObserver) new ResizeObserver(publishBottom).observe(header);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(publishBottom);

    var initOverlay = function () {
      if (!header.classList.contains('is-sticky')) return;
      var cover = document.querySelector('main .cover:first-child');
      var darkHero = document.querySelector('main .surface-dark:first-child .hero-grid, main .surface-gradient:first-child .hero-grid');
      var hero = cover || (darkHero && darkHero.closest('.surface-dark, .surface-gradient'));
      if (!hero) return;
      var text = hero.querySelector('.cover__inner > :first-child, .hero-grid > :first-child') || hero;
      var trigger = 0;
      var measure = function () {
        trigger = Math.max(0, text.getBoundingClientRect().top + window.scrollY - (header.offsetHeight || 64));
      };
      // A phone-only sticky header scrolls away like any other on a wide screen, so the stuck paint has to stay behind its breakpoint too.
      var stuckable = function () { return !header.classList.contains('is-sticky--phone') || mobile.matches; };
      var onScroll = function () { header.classList.toggle('solid', stuckable() && window.scrollY > trigger); };
      measure(); onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', function () { measure(); onScroll(); }, { passive: true });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initOverlay);
    else initOverlay();
  })();
</script>
