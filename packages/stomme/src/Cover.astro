---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// With no image the placeholder SVG is drawn as a CSS mask so the default art takes the brand tint — an <img> can't inherit currentColor.
interface Props {
  src?: string;
  alt: string;
  width?: number;
  height?: number;
  placeholder: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}
const { src, alt, width, height, placeholder, class: cls, loading = 'lazy' } = Astro.props;

// Uploads are optimizable only because the build-bridge mirrors public/media → src/assets/media; any other path falls through to a plain <img>.
const uploads = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/media/**/*.{jpg,jpeg,png,webp,avif}',
);
const key = src && src.startsWith('/media/') ? `/src/assets/media/${src.slice('/media/'.length)}` : null;
const optimized = key && uploads[key] ? uploads[key] : null;
const dims = { ...(width ? { width } : {}), ...(height ? { height } : {}) };
// A width AND a height reach sharp as a crop box, so an optimized upload takes the width alone and keeps its own shape; the plain <img> keeps both, its only ratio before the file lands.
const optimizedDims = width ? { width } : dims;
---

{
  optimized ? (
    <Image src={optimized()} alt={alt} {...optimizedDims} class={cls} loading={loading} />
  ) : src ? (
    <img src={src} alt={alt} {...dims} loading={loading} class={cls} decoding="async" />
  ) : (
    <span
      class:list={[cls, 'ph-tint']}
      role="img"
      aria-label={alt}
      style={`-webkit-mask-image:url(${placeholder});mask-image:url(${placeholder})`}
    />
  )
}
