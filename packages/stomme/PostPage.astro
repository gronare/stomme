---
import Cover from './src/Cover.astro';
import { renderMarkdown } from './src/markdown';
import { resolveSite, type SiteConfig } from './src/config';

interface Props {
  post: any;
  config?: SiteConfig;
  listing?: { route?: string };
}
const { post, config } = Astro.props;
const site = resolveSite(config);
const html = await renderMarkdown(post.body ?? '');
const listing = Astro.props.listing ?? site.listings.find((l) => l.id === post.collection);
const fmt = (d: string) => new Date(d).toLocaleDateString(site.locale, { year: 'numeric', month: 'long', day: 'numeric' });
const date = post.data.date ? fmt(post.data.date) : '';
const eventLine = post.data.eventDate ? [fmt(post.data.eventDate), post.data.eventTime].filter(Boolean).join(' · ') : '';
---
<article data-stomme-page="news" data-stomme-entry={post.id} class="section section--read">
  {post.data.showCover && (
    <Cover src={post.data.cover} alt={post.data.title} placeholder="/images/placeholders/service.svg" width={1100} height={620} loading="eager" class="post-article__cover" />
  )}
  {listing?.route && <a class="post-back" href={listing.route}>← {site.strings.post.back}</a>}
  {date && <p class="mono">{date}</p>}
  <h1 class="display display--hero" style="margin-top:0.5rem">{post.data.title}</h1>
  {(eventLine || post.data.category) && (
    <p class:list={['mono', { 'post-date--event': !!eventLine }]}>
      {eventLine}
      {post.data.category && <span class="post-cat">{post.data.category}</span>}
    </p>
  )}
  <div class="prose" style="margin-top:1.5rem" set:html={html} />
</article>
