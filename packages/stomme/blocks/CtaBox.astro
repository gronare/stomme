---
import { resolveButton } from '../src/href';
import Emph from '../src/Emph.astro';

interface Fact { label?: string; value?: string }
interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  cta?: { label?: string; link?: unknown };
  cta2?: { label?: string; link?: unknown };
  label?: string;
  href?: unknown;
  label2?: string;
  href2?: unknown;
  facts?: Fact[];
  layout?: { variant?: 'classic' | 'split' | 'panel' };
  anchor?: string;
}
const { eyebrow, heading, intro, cta, cta2, label, href, label2, href2, facts = [], anchor } = Astro.props;
const variant = Astro.props.layout?.variant ?? 'classic';
const btn = resolveButton(cta, label, href);
const btn2 = resolveButton(cta2, label2, href2);
const shownFacts = (facts ?? []).filter((f) => f && (f.label || f.value));
const hasFacts = variant !== 'classic' && shownFacts.length > 0;
---

<section data-stomme-block="ctaBox" id={anchor || undefined} class="section">
  <div class:list={['ctabox', `ctabox--${variant}`]}>
    <div class="ctabox-copy">
      {eyebrow && <span class="mono ctabox-eyebrow">{eyebrow}</span>}
      <h2 class="display ctabox-heading"><Emph text={heading} /></h2>
      {intro && <p class="ctabox-intro">{intro}</p>}
      {btn && <a href={btn.href} class="ctabox-btn">{btn.label}</a>}
      {btn2 && <a href={btn2.href} class="btn-ghost ctabox-link2">{btn2.label} →</a>}
    </div>

    {hasFacts && variant === 'split' && (
      <ul class="ctabox-aside" aria-hidden="true">
        {shownFacts.map((f) => (
          <li class="ctabox-chip">{f.label && <span>{f.label}</span>}{f.value && <b>{f.value}</b>}</li>
        ))}
      </ul>
    )}

    {hasFacts && variant === 'panel' && (
      <dl class="ctabox-readout">
        {shownFacts.map((f) => (
          <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
    )}
  </div>
</section>
