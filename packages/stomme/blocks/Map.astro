---
import Cover from '../src/Cover.astro';

interface Props {
  address?: string;
  note?: string;
  media?: { image?: string; imageAlt?: string; credit?: string; pinX?: number; pinY?: number };
  coords?: { lat?: number; lng?: number };
  site?: any;
}
const { address, note, site } = Astro.props;
const media = Astro.props.media ?? {};
const coords = Astro.props.coords ?? {};
const copy = site?.strings?.map ?? {};
const num = (v: unknown) => (typeof v === 'number' && Number.isFinite(v) ? v : null);
const lat = num(coords.lat);
const lng = num(coords.lng);
// A coordinate pair is already URL-safe, and both map apps read the raw comma; only the address needs escaping.
const dest = lat !== null && lng !== null ? `${lat},${lng}` : encodeURIComponent(String(address ?? ''));
const google = `https://www.google.com/maps/dir/?api=1&destination=${dest}`;
const apple = `https://maps.apple.com/?daddr=${dest}`;
const pinX = num(media.pinX);
const pinY = num(media.pinY);
const pin = pinX !== null && pinY !== null;
const key = typeof site?.maps?.key === 'string' ? site.maps.key.trim() : '';
// An unrecognised provider reads as unset, so a typo on a keyed site keeps the map it already has instead of silently losing it.
const named = site?.maps?.provider === 'osm' || site?.maps?.provider === 'google' ? site.maps.provider : '';
const provider = named || (key !== '' ? 'google' : '');
const osm = provider === 'osm';
const embeddable = lat !== null && lng !== null && (osm || (provider === 'google' && key !== ''));
const embedLabel = (osm ? copy.embedOsm : copy.embed) ?? (osm ? 'Show in OpenStreetMap' : 'Show in Google Maps');
const embedNote = (osm ? copy.embedNoteOsm : copy.embedNote)
  ?? `The map loads from ${osm ? 'OpenStreetMap' : 'Google'} only once you click.`;
const embedTitle = String((osm ? copy.embedTitleOsm : copy.embedTitle) ?? `${osm ? 'OpenStreetMap map' : 'Google map'} of {address}`)
  .replace('{address}', address || `${lat},${lng}`);
const span = (v: number, by: number) => (v + by).toFixed(6);
// OpenStreetMap frames by box rather than zoom: ±0.008 lon by ±0.004 lat is the same neighbourhood Google shows at zoom 15.
const bbox = osm && lat !== null && lng !== null
  ? `${span(lng, -0.008)},${span(lat, -0.004)},${span(lng, 0.008)},${span(lat, 0.004)}`
  : '';
---

{(address || media.image) && (
  <section data-stomme-block="map" class="section">
    <div class="mapblock">
      <div class="mapblock__map">
        <Cover src={media.image} alt={media.imageAlt ?? ''} placeholder="/images/placeholder.svg" width={1400} height={560} class="mapblock__img" />
        {pin && (
          <span class="mapblock__pin" style={`left:${pinX}%;top:${pinY}%`} aria-hidden="true">
            {address && <span class="mapblock__pinlabel">{address}</span>}
            <i class="mapblock__pindot"></i>
          </span>
        )}
        {media.credit && <span class="mapblock__credit">{media.credit}</span>}
        {embeddable && (
          <div class="mapblock__embed" data-stomme-map-embed data-provider={provider} data-key={key}
            data-q={`${lat},${lng}`} data-bbox={bbox} data-title={embedTitle}>
            <button type="button" class="btn mapblock__embedbtn">{embedLabel}</button>
            <span class="mapblock__embednote">{embedNote}</span>
          </div>
        )}
      </div>
      {embeddable && (
        <script is:inline>
          for (const bar of document.querySelectorAll('[data-stomme-map-embed]:not([data-stomme-bound])')) {
            bar.setAttribute('data-stomme-bound', '');
            const canvas = bar.closest('.mapblock__map');
            const button = bar.querySelector('button');
            if (!canvas || !button) continue;
            button.addEventListener('click', () => {
              if (canvas.querySelector('iframe')) return;
              const frame = document.createElement('iframe');
              frame.className = 'mapblock__frame';
              frame.title = bar.getAttribute('data-title') || '';
              frame.loading = 'lazy';
              frame.allowFullscreen = true;
              const q = encodeURIComponent(bar.getAttribute('data-q') || '');
              const k = encodeURIComponent(bar.getAttribute('data-key') || '');
              const bbox = encodeURIComponent(bar.getAttribute('data-bbox') || '');
              frame.src = bar.getAttribute('data-provider') === 'osm'
                ? 'https://www.openstreetmap.org/export/embed.html?bbox=' + bbox + '&layer=mapnik&marker=' + q
                : 'https://www.google.com/maps/embed/v1/place?key=' + k + '&q=' + q + '&zoom=15';
              canvas.appendChild(frame);
              bar.remove();
            });
          }
        </script>
      )}
      <div class="mapblock__row">
        <p class="mapblock__where">
          {address && <b class="mapblock__addr">{address}</b>}
          {note && <span class="mapblock__note">{note}</span>}
        </p>
        <div class="mapblock__links">
          <a class="btn" href={google} target="_blank" rel="noopener">{copy.google ?? 'Open in Google Maps'}</a>
          <a class="btn btn-outline" href={apple} target="_blank" rel="noopener">{copy.apple ?? 'Apple Maps'}</a>
        </div>
      </div>
    </div>
  </section>
)}
