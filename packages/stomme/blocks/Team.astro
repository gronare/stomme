---
import Cover from '../src/Cover.astro';

interface Person {
  image?: string;
  name: string;
  role?: string;
  email?: string;
  phone?: string;
  linkUrl?: string;
  linkLabel?: string;
  bio?: string;
}
interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: string;
  items?: Person[];
  anchor?: string;
}
const { eyebrow, heading, intro, items = [], anchor } = Astro.props;
const telHref = (v: string) => v.replace(/[\s.()-]/g, '');
const linkText = (p: Person) => p.linkLabel || (p.linkUrl ?? '').replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/+$/, '');
---
{(heading || items.length > 0) && (
  <section data-stomme-block="team" id={anchor || undefined} class="section">
    {(eyebrow || heading || intro) && (
      <div class="section-head">
        {eyebrow && <span class="mono eyebrow">{eyebrow}</span>}
        {heading && <h2 class="display" style="margin-top:0.75rem">{heading}</h2>}
        {intro && <p class="intro">{intro}</p>}
      </div>
    )}
    <div class="team-grid">
      {items.map((p) => (
        <div class="card person">
          <Cover src={p.image} alt={p.name} placeholder="/images/placeholders/avatar.svg" width={640} height={640} class="person__img" />
          <div class="person__body">
            <h3 class="person__name">{p.name}</h3>
            {p.role && <p class="mono person__role">{p.role}</p>}
            {(p.email || p.phone || p.linkUrl) && (
              <ul class="person__contact">
                {p.email && <li><a href={`mailto:${p.email}`}>{p.email}</a></li>}
                {p.phone && <li><a href={`tel:${telHref(p.phone)}`}>{p.phone}</a></li>}
                {p.linkUrl && <li><a href={p.linkUrl} target="_blank" rel="noopener">{linkText(p)}</a></li>}
              </ul>
            )}
            {p.bio && <p class="person__bio">{p.bio}</p>}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
