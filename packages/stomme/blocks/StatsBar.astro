---
interface Props { items?: { label: string; value: string }[]; anchor?: string }
const { items, anchor } = Astro.props;
const facts = Array.isArray(items) ? items : [];
---
{facts.length > 0 && (
  <section data-stomme-block="statsBar" id={anchor || undefined} class="section">
    <dl class="facts-grid">
      {facts.map((f) => (
        <div class="fact">
          <dt class="mono">{f.label}</dt>
          <dd class="fact-value">{f.value}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
