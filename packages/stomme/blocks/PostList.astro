---
import { getCollection } from 'astro:content';
import Cover from '../src/Cover.astro';
import { renderMarkdown } from '../src/markdown';

interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: string;
  text?: string;
  media?: { showImages?: boolean; style?: string };
  layout?: { featured?: boolean; columns?: number; limit?: number };
  source?: string;
  base?: string;
  items?: { id: string; data: Record<string, any> }[];
  site?: any;
  anchor?: string;
}
const { eyebrow, heading, intro, source = 'posts', base, site, anchor } = Astro.props;
const showImages = Astro.props.media?.showImages ?? false;
const corner = Astro.props.media?.style === 'corner';
const featured = Astro.props.layout?.featured ?? false;
const columns = Astro.props.layout?.columns ?? 3;
const limit = Number(Astro.props.layout?.limit) || 0;
const ItemHeading = heading ? 'h3' : 'h2';
const prefix = base ?? site?.routes?.blog ?? '/blog';
const locale = site?.locale ?? 'en-US';
const readMore = site?.strings?.readMore ?? 'Read more';
const latest = site?.strings?.latest ?? 'Latest';
const sorted = Astro.props.items ?? (await getCollection(source)).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const all = limit > 0 ? sorted.slice(0, limit) : sorted;
const fmt = (d: string) => new Date(d).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
const dateLine = (d: Record<string, any>) => fmt(d.date);
const fullText = Astro.props.text === 'full';
const bodyHtml = new Map<string, string>();
if (fullText) for (const p of all) if ((p as any).body) bodyHtml.set(p.id, await renderMarkdown((p as any).body));
const lead = featured && all.length > 1 ? all[0] : null;
const rest = lead ? all.slice(1) : all;
const PLACE = '/images/placeholders/service.svg';
const leadHasImg = !!(lead && showImages && lead.data.showCover);
const hasImg = (p: any) => !!(showImages && p.data.showCover);
---
{all.length > 0 && (
  <section data-stomme-block="postList" id={anchor || undefined} class="section">
    {(eyebrow || heading || intro) && (
      <div class="section-head post-head">
        {eyebrow && <span class="mono eyebrow">{eyebrow}</span>}
        {heading && <h2 class="display" style="margin-top:0.75rem">{heading}</h2>}
        {intro && <p class="intro">{intro}</p>}
      </div>
    )}
    {lead && (
      <a href={`${prefix}/${lead.id}`} class:list={['post-feature', { 'post-feature--text': !leadHasImg }]}>
        <span class="post-latest">{latest}</span>
        {leadHasImg && (
          <Cover src={lead.data.cover} alt={lead.data.title} placeholder={PLACE} width={1000} height={640} class="post-feature__img" />
        )}
        <div class="post-feature__body">
          <p class="mono">
            {dateLine(lead.data)}
            {lead.data.category && <span class="post-cat">{lead.data.category}</span>}
          </p>
          <ItemHeading class="post-feature__title">{lead.data.title}</ItemHeading>
          {bodyHtml.get(lead.id) ? (
            <div class="post-excerpt post-body" set:html={bodyHtml.get(lead.id)} />
          ) : (
            lead.data.excerpt && <p class="post-excerpt">{lead.data.excerpt}</p>
          )}
          <span class="mono post-more">{readMore} →</span>
        </div>
      </a>
    )}
    {rest.length > 0 && (
      <div class="post-grid" style={`--post-cols:${columns}`}>
        {rest.map((p) => (
          <a href={`${prefix}/${p.id}`} class:list={['post-card', corner && 'post-card--corner']}>
            {hasImg(p) && (
              <Cover src={p.data.cover} alt={p.data.title} placeholder={PLACE} width={800} height={480} class="post-card__img" />
            )}
            <div class="post-card__body">
              <p class="mono">
                {dateLine(p.data)}
                {p.data.category && <span class="post-cat">{p.data.category}</span>}
              </p>
              <ItemHeading class="post-title">{p.data.title}</ItemHeading>
              {bodyHtml.get(p.id) ? (
                <div class="post-excerpt post-body" set:html={bodyHtml.get(p.id)} />
              ) : (
                p.data.excerpt && <p class="post-excerpt">{p.data.excerpt}</p>
              )}
              <span class="mono post-more">{readMore} →</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
)}
