---
import DirectContact from '../src/DirectContact.astro';
interface Props {
  label?: string;
  tint?: boolean;
  show?: string[];
  anchor?: string;
}
const { label, tint, show = [], anchor } = Astro.props;
const on = (k: string) => show.includes(k);
---
<section data-stomme-block="contactCard" id={anchor || undefined} class="section">
  <div class="contact-card-block">
    <DirectContact
      label={label}
      tint={tint === true}
      show={{ phone: on('phone'), email: on('email'), hours: on('hours'), address: on('address'), socials: on('socials'), map: on('map') }}
    />
  </div>
</section>
