---
interface Props { lead?: string; logos?: string[]; anchor?: string }
const { lead, logos, anchor } = Astro.props;
const names = Array.isArray(logos) ? logos.filter(Boolean) : [];
---
{names.length > 0 && (
  <section data-stomme-block="logoStrip" id={anchor || undefined} class="partner-strip">
    <div class="section" style="text-align:center">
      {lead && <p class="mono">{lead}</p>}
      <div class="partner-logos">{names.map((p) => <span>{p}</span>)}</div>
    </div>
  </section>
)}
