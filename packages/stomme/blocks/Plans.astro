---
import { resolveButton } from '../src/href';
import Emph from '../src/Emph.astro';

interface Plan {
  name?: string;
  pricePrefix?: string;
  price?: string;
  period?: string;
  description?: string;
  features?: { text?: string }[];
  badge?: string;
  highlight?: boolean;
  cta?: { label?: string; link?: unknown };
  ctaLabel?: string;
  ctaHref?: unknown;
}
interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: string;
  plans?: Plan[];
  footnote?: string;
}
const { eyebrow, heading, intro, plans = [], footnote } = Astro.props;
const anyPrefix = plans.some((p) => p.pricePrefix);
---

{(heading || plans.length > 0) && (
  <section data-stomme-block="plans" class="section">
    {(eyebrow || heading || intro) && (
      <div class="section-head">
        {eyebrow && <span class="mono eyebrow">{eyebrow}</span>}
        {heading && <h2 class="display plans__heading"><Emph text={heading} /></h2>}
        {intro && <p class="intro">{intro}</p>}
      </div>
    )}
    <div class="plans">
      {plans.map((p) => (
        <div class:list={['plan', { 'plan--highlight': p.highlight }]}>
          {p.name && <h3 class="plan__name">{p.name}{p.badge && <span class="plan__badge">{p.badge}</span>}</h3>}
          {!p.name && p.badge && <span class="plan__badge">{p.badge}</span>}
          {p.price && (
            <div class="plan__price">
              {anyPrefix && <span class="plan__prefix">{p.pricePrefix ?? ' '}</span>}
              {/* ONE source line, no template whitespace: the zero-width space is the ONLY break point between the two no-break spans (the period gap is its margin), so the period stays on the line when it fits and wraps cleanly when not — never reflow this. */}
              <span class="plan__amount">{p.price}</span>{p.period && '\u200b'}{p.period && <span class="plan__period">{p.period}</span>}
            </div>
          )}
          {p.description && <p class="plan__desc"><Emph text={p.description} /></p>}
          {p.features && p.features.length > 0 && (
            <ul class="plan__features">
              {p.features.filter((f) => f && f.text).map((f) => <li><Emph text={f.text} /></li>)}
            </ul>
          )}
          {(() => { const btn = resolveButton(p.cta, p.ctaLabel, p.ctaHref); return btn && (
            <a href={btn.href} class="btn plan__cta">{btn.label}</a>
          ); })()}
        </div>
      ))}
    </div>
    {footnote && <p class="plans__footnote"><Emph text={footnote} /></p>}
  </section>
)}
