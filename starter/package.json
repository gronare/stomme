{
  "name": "stomme-starter",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "astro dev",
    "build": "stomme-gen && astro build",
    "preview": "pnpm run build:static && STOMME_TARGET=static astro preview",
    "cms:gen": "stomme-gen",
    "block:new": "stomme-new-block",
    "lint:content": "stomme-lint-content",
    "build:static": "STOMME_TARGET=static pnpm run build",
    "build:cloudflare": "STOMME_TARGET=cloudflare pnpm run build",
    "build:vercel": "STOMME_TARGET=vercel pnpm run build",
    "build:node": "STOMME_TARGET=node pnpm run build"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.3",
    "@astrojs/sitemap": "^3.7.3",
    "@gronare/stomme": "workspace:*",
    "astro": "^7.2.9",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "wrangler": "^4.125.0"
  },
  "license": "AGPL-3.0-only"
}
