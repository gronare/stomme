---
import '../styles/global.css';
import { getEntry, getCollection } from 'astro:content';
import { resolveFonts, curatedWebfontUrls } from '@gronare/stomme/fonts';
import { themeStyle, nightStyle } from '@gronare/stomme/theme';
import Header from '@gronare/stomme/Header.astro';
import Footer from '@gronare/stomme/Footer.astro';
import Tracking from '@gronare/stomme/Tracking.astro';
import ConsentBanner from '@gronare/stomme/ConsentBanner.astro';
import StommeHead from '@gronare/stomme/Head.astro';
import { pageLang } from '@gronare/stomme/i18n';
import { site } from '../site.config';

// Nothing in this repo passes `chrome`: the engine's generated CMS previews render into this layout with chrome={false} to isolate one component.
// `lang` comes from the generated locale routes and names the language actually rendered, which is the default one whenever a page has no translation.
interface Props { title?: string; description?: string; image?: string; chrome?: boolean; lang?: string }
const { title, description, image, chrome = true, lang } = Astro.props;

const theme = (await getEntry('theme', 'theme'))!.data;
const footerCfg = ((await getEntry('footer', 'footer'))?.data ?? {}) as any;
const towns = footerCfg.showTowns === true
  ? (await getCollection('towns'))
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
      .map((t) => ({ id: t.id, name: t.data.name }))
  : [];
const fonts = resolveFonts(theme, curatedWebfontUrls());
const themeVars = themeStyle(theme, fonts.vars);
const night = nightStyle(theme);
---
<!doctype html>
<html lang={pageLang(Astro.url.pathname, site, lang)} style={themeVars} data-eyebrow={theme.eyebrow}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <StommeHead title={title} description={description} image={image} />
    {fonts.preloads.map((p) => <link rel="preload" as="font" type={p.type} href={p.href} crossorigin />)}
    {fonts.fontFace && <style is:inline set:html={fonts.fontFace}></style>}
    {night && <style is:inline set:html={night}></style>}
    {chrome && <Tracking />}
  </head>
  <body>
    {chrome && <Header />}
    <main><slot /></main>
    {chrome && <Footer towns={towns} townsHref={site.routes?.towns ?? '/areas'} />}
    {chrome && <ConsentBanner />}
  </body>
</html>
