---
import Base from '../layouts/Base.astro';
import BlockRenderer from '@gronare/stomme/BlockRenderer.astro';
import { getCollection } from 'astro:content';
import { defaultLocaleEntries } from '@gronare/stomme/i18n';
import { site, features } from '../site.config';

export async function getStaticPaths() {
  const pages = defaultLocaleEntries(await getCollection('pages'), site).filter((p) => p.data.published !== false);
  return pages.map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}
const { page } = Astro.props;
---
<Base title={page.data.seo.title} description={page.data.seo.description} image={page.data.seo.image}>
  <BlockRenderer blocks={page.data.blocks} config={site} features={features} />
</Base>
